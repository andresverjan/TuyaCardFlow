@CardService_HostAddress = http://localhost:5143

### Antes: ejecuta Users.http para iniciar sesión y definir userId.
### Obtener el token CSRF para la primera escritura
GET {{CardService_HostAddress}}/api/auth/csrf
Accept: application/json

> {% client.global.set("csrfToken", response.body.token); %}

### Crear una tarjeta del usuario autenticado
POST {{CardService_HostAddress}}/api/cards
Content-Type: application/json
Accept: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "userId": "{{userId}}",
  "holderName": "Ana Pérez",
  "brand": "Tuya",
  "last4": "1234",
  "expirationMonth": 12,
  "expirationYear": 2030
}

> {%
    client.test("Tarjeta creada", function () {
        client.assert(response.status === 201, "Se esperaba HTTP 201");
    });
    if (response.status === 201) {
        client.global.set("cardId", response.body.id);
    }
%}

### Consultar las tarjetas del usuario
GET {{CardService_HostAddress}}/api/cards/user/{{userId}}
Accept: application/json

### Consultar una tarjeta
GET {{CardService_HostAddress}}/api/cards/{{cardId}}
Accept: application/json

### Actualizar una tarjeta (PUT reemplaza todos los datos editables)
PUT {{CardService_HostAddress}}/api/cards/{{cardId}}
Content-Type: application/json
Accept: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "holderName": "Ana María Pérez",
  "brand": "Tuya",
  "last4": "9876",
  "expirationMonth": 10,
  "expirationYear": 2032
}

### Eliminar una tarjeta
DELETE {{CardService_HostAddress}}/api/cards/{{cardId}}
X-CSRF-TOKEN: {{csrfToken}}

### Después de eliminar, devuelve HTTP 404
GET {{CardService_HostAddress}}/api/cards/{{cardId}}
Accept: application/json
