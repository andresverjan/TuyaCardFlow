<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp/node_modules/**</DefaultItemExcludes>
    <BuildClientApp Condition="'$(BuildClientApp)' == ''">true</BuildClientApp>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="ClientApp/**" />
    <None Remove="ClientApp/node_modules/**" />
    <ClientSources Include="ClientApp/src/**;ClientApp/public/**;ClientApp/index.html;ClientApp/vite.config.js;ClientApp/package.json;ClientApp/package-lock.json" />
  </ItemGroup>
  <Target Name="BuildReact" BeforeTargets="BeforeBuild"
    Condition="'$(BuildClientApp)' == 'true'"
    Inputs="@(ClientSources)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html">
    <Exec WorkingDirectory="ClientApp" Command="npm ci" Condition="!Exists('ClientApp/node_modules/.package-lock.json')" />
    <Exec WorkingDirectory="ClientApp" Command="npm run build" />
  </Target>
  <Target Name="IncludeReactPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="wwwroot/**" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
